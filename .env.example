# Local development database. `npm run db:up` publishes PostgreSQL only on
# this computer at port 5433. Railway provides its own DATABASE_URL in prod.
DATABASE_URL="postgresql://sunnie_local:sunnie_local@127.0.0.1:5433/sunnie_local"

# NextAuth Configuration
# Use domain in production, localhost for development
NEXTAUTH_URL="http://localhost:3000"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXTAUTH_SECRET="your-secret-key-min-32-chars"
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

NEXT_PUBLIC_ENABLE_SAAS_FEATURES=false

RESEND_API_KEY=
RESEND_FROM_EMAIL=
